---
import { Picture } from 'astro:assets';
import bannerPoster from '../assets/generated/repo_banner_poster.png';

const { entry, id } = Astro.locals.starlightRoute;
const isHome = id === '' || id === 'index';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{
  isHome ? (
    <section class="cspa-hero">
      <div class="cspa-hero-banner-shell" data-animated-banner={`${base}/repo_banner.svg`}>
        <div class="cspa-hero-banner-svg-host" aria-hidden="true" />
        <Picture
          src={bannerPoster}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[480, 720, 1080, 1440]}
          sizes="(max-width: 62rem) 92vw, 928px"
          quality={62}
          alt="capture-system-or-process-audio — Cross-platform system speaker loopback, single application/process, and microphone PCM audio capture library for Python, Rust, C++17, and C11"
          class="cspa-hero-banner"
          width={1200}
          height={400}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
      <h1 id="_top" class="cspa-hero-h1">
        {entry.data.title}
      </h1>
      <p class="cspa-hero-lead">
        <strong>
          Capture system speakers, isolate any single app/process, or mix microphones into one live PCM stream across
          Windows, Linux &amp; macOS.
        </strong>
      </p>
      <p class="cspa-hero-sub">
        Native WASAPI · PipeWire · PulseAudio · Core Audio Process Taps · ScreenCaptureKit — zero virtual audio cables,
        zero silent fallbacks.
      </p>
      <div class="cspa-trust-pill">
        <span>
          Created by <a href="https://github.com/s0d3s">@s0d3s</a> — author of{' '}
          <a href="https://github.com/s0d3s/PyAudioWPatch">
            <strong>PyAudioWPatch</strong>
          </a>{' '}
          (140,000+ monthly PyPI downloads, 340+ dependent repos) — nearly a year of ground-up safe-Rust engineering &amp; polish.
        </span>
      </div>
      <div class="cspa-cta-row">
        <a href={`${base}/getting-started/overview/`} class="cspa-btn cspa-btn-primary">
          Read the Manual →
        </a>
        <a href="#live-4-sdk-quick-start" class="cspa-btn cspa-btn-secondary">
          ⚡ 4-SDK Switcher ↓
        </a>
        <a href={`${base}/studio-demo/`} class="cspa-btn cspa-btn-secondary">
          🎛️ Studio Demo
        </a>
        <a href={`${base}/reference/`} class="cspa-btn cspa-btn-secondary">
          📚 API Reference
        </a>
      </div>
    </section>
  ) : (
    <h1 id="_top" class="cspa-doc-h1">
      {entry.data.title}
    </h1>
  )
}

{
  isHome && (
    <script>
      (() => {
        const shell = document.querySelector<HTMLElement>('.cspa-hero-banner-shell[data-animated-banner]');
        const posterImg = shell?.querySelector<HTMLImageElement>('img.cspa-hero-banner');
        const svgUrl = shell?.dataset.animatedBanner;
        if (!shell || !svgUrl) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const conn = (
          navigator as Navigator & {
            connection?: { saveData?: boolean; effectiveType?: string; downlink?: number };
          }
        ).connection;
        if (conn?.saveData || /(^|-)2g$/i.test(conn?.effectiveType ?? '')) return;

        const isConstrainedNetwork =
          conn?.effectiveType === '3g' || (typeof conn?.downlink === 'number' && conn.downlink > 0 && conn.downlink < 2.5);

        let started = false;
        let fallbackTimer: ReturnType<typeof setTimeout> | undefined;
        let initialPointer: { x: number; y: number } | null = null;
        const directEvents = ['pointerdown', 'touchstart', 'wheel', 'scroll', 'keydown'] as const;

        const onPointerMove = (e: PointerEvent) => {
          if (!initialPointer) {
            initialPointer = { x: e.clientX, y: e.clientY };
            return;
          }
          if (Math.hypot(e.clientX - initialPointer.x, e.clientY - initialPointer.y) >= 4) {
            upgradeToAnimatedSvg();
          }
        };

        const detachListeners = () => {
          for (const evt of directEvents) {
            window.removeEventListener(evt, upgradeToAnimatedSvg);
          }
          window.removeEventListener('pointermove', onPointerMove);
          if (fallbackTimer !== undefined) {
            clearTimeout(fallbackTimer);
            fallbackTimer = undefined;
          }
        };

        function nextFrame(): Promise<void> {
          if (document.visibilityState === 'hidden') {
            return new Promise((resolve) => setTimeout(resolve, 32));
          }
          return new Promise((resolve) => {
            let settled = false;
            const finish = () => {
              if (!settled) {
                settled = true;
                resolve();
              }
            };
            requestAnimationFrame(finish);
            setTimeout(finish, 100);
          });
        }

        function waitUntilTabVisible(): Promise<void> {
          if (document.visibilityState === 'visible') return Promise.resolve();
          return new Promise((resolve) => {
            const onVis = () => {
              if (document.visibilityState === 'visible') {
                document.removeEventListener('visibilitychange', onVis);
                resolve();
              }
            };
            document.addEventListener('visibilitychange', onVis);
          });
        }

        async function upgradeToAnimatedSvg() {
          if (started || !shell || !svgUrl) return;
          const svgHost = shell.querySelector<HTMLElement>('.cspa-hero-banner-svg-host');
          if (!svgHost) return;
          started = true;
          detachListeners();

          try {
            const resp = await fetch(svgUrl, { credentials: 'same-origin' });
            if (!resp.ok) return;
            const svgMarkup = await resp.text();
            if (!shell.isConnected) return;

            const parsed = new DOMParser().parseFromString(svgMarkup, 'image/svg+xml');
            const parsedRoot = parsed.documentElement;
            if (!parsedRoot || parsedRoot.tagName.toLowerCase() !== 'svg') return;

            const svgEl = document.importNode(parsedRoot, true) as unknown as SVGSVGElement;
            svgEl.removeAttribute('width');
            svgEl.removeAttribute('height');
            svgEl.setAttribute('preserveAspectRatio', 'xMidYMid slice');
            svgEl.setAttribute('focusable', 'false');
            svgEl.setAttribute('aria-hidden', 'true');

            // Freeze SMIL animations at exact t = 0 before attaching to the live document
            if (typeof svgEl.pauseAnimations === 'function') {
              svgEl.pauseAnimations();
            }
            if (typeof svgEl.setCurrentTime === 'function') {
              svgEl.setCurrentTime(0);
            }

            // Pre-decode embedded bitmap layers so the SVG paints completely on its first frame
            const embeddedImages = Array.from(svgEl.querySelectorAll('image'));
            await Promise.all(
              embeddedImages.map((imgNode) => {
                const href = imgNode.getAttribute('href') || imgNode.getAttribute('xlink:href');
                if (!href) return Promise.resolve();
                const pre = new Image();
                pre.decoding = 'async';
                pre.src = href;
                return typeof pre.decode === 'function' ? pre.decode().catch(() => {}) : Promise.resolve();
              })
            );
            if (!shell.isConnected) return;

            const shadow = svgHost.shadowRoot ?? svgHost.attachShadow({ mode: 'open' });
            shadow.textContent = '';

            const baseStyle = document.createElement('style');
            baseStyle.textContent =
              ':host{display:block;width:100%;height:100%}svg{display:block;width:100%;height:100%}';

            // Keep all CSS @keyframes frozen at t = 0 until the rasterized poster is hidden
            const pauseStyle = document.createElement('style');
            pauseStyle.textContent = 'svg *,svg *::before,svg *::after{animation-play-state:paused!important}';

            shadow.append(baseStyle, pauseStyle, svgEl);

            if (typeof svgEl.pauseAnimations === 'function') {
              svgEl.pauseAnimations();
            }
            if (typeof svgEl.setCurrentTime === 'function') {
              svgEl.setCurrentTime(0);
            }

            // Allow two compositor frames for SVG filters and layers to rasterize invisibly behind the poster
            await nextFrame();
            await nextFrame();
            if (!shell.isConnected) return;

            // 1. Hide rasterized poster first while SVG underneath is still frozen at the identical t = 0 frame
            shell.classList.add('is-svg-ready');

            // 2. Wait until the poster-hide frame commits (and tab is visible), then start CSS + SMIL animations from t = 0
            await nextFrame();
            await waitUntilTabVisible();
            if (!shell.isConnected) return;
            pauseStyle.remove();
            if (typeof svgEl.setCurrentTime === 'function') {
              svgEl.setCurrentTime(0);
            }
            if (typeof svgEl.unpauseAnimations === 'function') {
              svgEl.unpauseAnimations();
            }
          } catch {
            // Keep static high-DPI poster if network fetch fails
          }
        }

        const armAfterPosterReady = async () => {
          if (posterImg && !posterImg.complete) {
            await new Promise<void>((resolve) => {
              posterImg.addEventListener('load', () => resolve(), { once: true });
              posterImg.addEventListener('error', () => resolve(), { once: true });
            });
          }
          for (const evt of directEvents) {
            window.addEventListener(evt, upgradeToAnimatedSvg, { once: true, passive: true });
          }
          window.addEventListener('pointermove', onPointerMove, { passive: true });
          if (!isConstrainedNetwork) {
            fallbackTimer = setTimeout(upgradeToAnimatedSvg, 2500);
          }
        };

        if (document.readyState === 'complete') {
          void armAfterPosterReady();
        } else {
          window.addEventListener('load', () => void armAfterPosterReady(), { once: true });
        }
      })();
    </script>
  )
}

<style>
  .cspa-hero-h1 {
    margin: 0.4rem 0 0.5rem;
    font-size: clamp(1.85rem, 4vw, 2.75rem);
    line-height: 1.15;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }

  .cspa-doc-h1 {
    margin-top: 1rem;
    font-size: var(--sl-text-h1);
    line-height: var(--sl-line-height-headings);
    font-weight: 700;
    color: var(--sl-color-white);
  }
</style>
